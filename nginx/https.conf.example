# Install as default.conf and expose 443:443 in Compose after providing certificates.
server { listen 80; server_name email-health.example.com; return 301 https://$host$request_uri; }
server {
 listen 443 ssl;
 server_name email-health.example.com;
 ssl_certificate /etc/nginx/certs/fullchain.pem;
 ssl_certificate_key /etc/nginx/certs/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 resolver 127.0.0.11 valid=10s ipv6=off;
 set $backend_upstream backend:8000;
 set $frontend_upstream frontend:8080;
 client_max_body_size 64k;
 add_header Strict-Transport-Security "max-age=31536000" always;
 add_header X-Content-Type-Options nosniff always;
 add_header X-Frame-Options DENY always;
 add_header Referrer-Policy same-origin always;
 add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
 location = /email-monitoring { return 308 /email-monitoring/; }
 location /email-monitoring/api/ {
   rewrite ^/email-monitoring/(.*)$ /$1 break;
   proxy_pass http://$backend_upstream;
   proxy_set_header Host $host;
   proxy_set_header X-Real-IP $remote_addr;
   proxy_set_header X-Forwarded-For $remote_addr;
   proxy_set_header X-Forwarded-Proto $scheme;
 }
 location = /email-monitoring/openapi.json { rewrite ^/email-monitoring/(.*)$ /$1 break; proxy_pass http://$backend_upstream; }
 location /email-monitoring/ { rewrite ^/email-monitoring/(.*)$ /$1 break; proxy_pass http://$frontend_upstream; }
 location = /openapi.json { proxy_pass http://$backend_upstream; }
 location /api/ { proxy_pass http://$backend_upstream; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto https; }
 location / { proxy_pass http://$frontend_upstream; }
}
