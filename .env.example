# Generate independently; do not deploy example values. Never commit .env.
POSTGRES_PASSWORD=
# URL-encode special characters in the DB password.
DATABASE_URL=postgresql+psycopg://emailhealth:REPLACE_URL_ENCODED_PASSWORD@db:5432/emailhealth
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
ENCRYPTION_KEY=
ADMIN_EMAIL=admin@newhotmusic.com
ADMIN_PASSWORD=
DOMAIN=newhotmusic.com
COOKIE_SECURE=true
HTTP_PORT=80
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
DELIVERY_WEBHOOK_SECRET=
ABUSEIPDB_KEY=
DOMAIN_REPUTATION_URL=
DOMAIN_REPUTATION_KEY=
# Comma-separated zones. Configure only licensed/permitted sources.
DNSBL_ZONES=
DOMAIN_DNSBL_ZONES=
SEED_WAIT_SECONDS=120
SEED_MISSING_AFTER_SECONDS=900
DEMO_MODE=false
# Notification defaults; per-domain dashboard settings take precedence once saved.
ALERT_ENABLED=true
ALERT_REMINDER_SECONDS=300
DASHBOARD_URL=https://nhmdashboards.com/email-monitoring/
# Public DNS/SMTP and connected telemetry scans default to five minutes.
AUTH_INTERVAL_SECONDS=300
SMTP_INTERVAL_SECONDS=300
REPUTATION_INTERVAL_SECONDS=43200
BLACKLIST_INTERVAL_SECONDS=43200
PLACEMENT_INTERVAL_SECONDS=86400
# Optional separate authorized seed sender; blank uses notification SMTP and is labeled accordingly.
SEED_SMTP_HOST=
SEED_SMTP_PORT=587
SEED_SMTP_USER=
SEED_SMTP_PASSWORD=
SEED_SMTP_FROM=
SEED_SENDING_SOURCE=Dedicated authorized seed SMTP; production equivalence not verified
